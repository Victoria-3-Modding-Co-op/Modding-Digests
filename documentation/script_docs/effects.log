## ordered_subject_of_subject
Any country below direct subjects in hierarchy  
ordered_subject_of_subject = {  
limit = { <triggers> }  
order_by = script_value  
position = int  
min = int  
max = script_value  
check_range_bounds = no # If you don't want an error logged if the list is smaller than the min/max  
<effects> }
