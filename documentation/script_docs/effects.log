## ordered_state_in_afghanistan
german_clothes_pop_trigger = {  
	exists = scope:pop  
	scope:pop = {  
		home_country = {  
			is_subject = no  
			NOT = {  
				c:AUS ?= this  
			}  
			OR = {  
				country_has_primary_culture = cu:north_german  
				country_has_primary_culture = cu:south_german  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: state  

## ordered_state_in_africa
ai_country_is_valid_colonization_target = {  
	OR = {  
		is_country_type = unrecognized  
		is_country_type = decentralized # Could be useful for the rare cases this is used outside of AI strategies  
	}  
	OR = {  
		is_subject = no  
		top_overlord ?= {  
			is_country_type = unrecognized  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: state  

## ordered_state_in_allahabad_bombay_line
french_empire_clothes_pop_trigger = {  
	exists = scope:pop  
	scope:pop = {  
		exists = c:FRA  
		home_country = {  
			OR = {  
				AND = {  
					c:FRA = this  
					is_subject = no # preventing uniform conflicts if FRA becomes a subject of another country with puppet uniforms  
				}  
				is_subject_of = c:FRA  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: state  

