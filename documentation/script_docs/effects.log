	scope:pop = {  
		exists = c:RUS  
		home_country = {  
			OR = {  
				AND = {  
					c:RUS = this  
					is_subject = no # preventing uniform conflicts if RUS becomes a subject of another country with puppet uniforms  
				}  
				is_subject_of = c:RUS  
			}  
		}  
	}  
}
**Supported Scopes**: none  
**Supported Targets**: strategic_region  

